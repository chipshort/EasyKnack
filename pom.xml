<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.vin</groupId><artifactId>easy-knack</artifactId><version>0.3.1-SNAPSHOT</version>
  <name>EasyKnack</name><description>Standalone node-based audio workspace</description>
  <licenses>
    <license><name>GNU General Public License, version 3 only</name><url>https://www.gnu.org/licenses/gpl-3.0.html</url><distribution>repo</distribution></license>
  </licenses>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release><glswing.version>0.2.0-SNAPSHOT</glswing.version>
    <audio.cxx>clang++</audio.cxx>
    <easyknack.test.audio>false</easyknack.test.audio>
    <easyknack.buildDirectory>${project.basedir}/target</easyknack.buildDirectory>
  </properties>
  <dependencies>
    <dependency><groupId>com.vingame</groupId><artifactId>glswing</artifactId><version>${glswing.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <directory>${easyknack.buildDirectory}</directory>
    <resources>
      <resource><directory>docs</directory><targetPath>META-INF/easyknack/docs</targetPath>
        <includes><include>*.md</include><include>user/**/*.md</include><include>nodes/**/*.md</include><include>nodes/catalog.json</include></includes>
        <excludes><exclude>nodes/**/additive-oscillator-v*.md</exclude></excludes>
      </resource>
      <resource><directory>${project.basedir}</directory><targetPath>META-INF/easyknack/legal</targetPath><includes><include>LICENSE</include><include>THIRD-PARTY.md</include></includes></resource>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>native/audio-host/third_party/loris</directory><targetPath>META-INF/easyknack/legal/loris</targetPath><includes><include>COPYING</include><include>AUTHORS</include><include>PROVENANCE.md</include><include>OOURA-LICENSE.txt</include></includes></resource>
      <resource><directory>${project.basedir}</directory><targetPath>META-INF</targetPath><includes><include>LICENSE</include><include>THIRD-PARTY.md</include></includes></resource>
    </resources>
    <plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version>
      <executions>
        <execution><id>default-compile</id><configuration><compilerArgs>
          <arg>-processorpath</arg><arg>${project.build.directory}/node-processor</arg>
          <arg>-processor</arg><arg>com.vin.easyknack.processor.NodeProcessor</arg>
        </compilerArgs></configuration></execution>
        <execution><id>default-testCompile</id><configuration><proc>none</proc></configuration></execution>
      </executions>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version>
      <configuration><argLine>--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.desktop/sun.awt=ALL-UNNAMED --add-opens=java.desktop/sun.java2d=ALL-UNNAMED</argLine>
        <systemPropertyVariables>
          <easyknack.test.audio>${easyknack.test.audio}</easyknack.test.audio>
          <easyknack.test.cxx>${audio.cxx}</easyknack.test.cxx>
        </systemPropertyVariables>
      </configuration>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
      <configuration><archive><manifest><mainClass>com.vin.easyknack.EasyKnack</mainClass><addClasspath>true</addClasspath><classpathPrefix>lib/</classpathPrefix></manifest>
        <manifestEntries><Add-Opens>java.base/java.lang java.desktop/sun.awt java.desktop/sun.java2d</Add-Opens></manifestEntries>
      </archive></configuration>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.7.0</version>
      <executions><execution><id>runtime-libraries</id><phase>package</phase><goals><goal>copy-dependencies</goal></goals>
        <configuration><includeScope>runtime</includeScope><overWriteSnapshots>true</overWriteSnapshots><outputDirectory>${project.build.directory}/lib</outputDirectory></configuration>
      </execution></executions>
    </plugin>
    <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
      <configuration><mainClass>com.vin.easyknack.EasyKnack</mainClass></configuration>
      <executions><execution><id>compile-node-processor</id><phase>generate-sources</phase><goals><goal>exec</goal></goals>
        <configuration><executable>${java.home}/bin/javac</executable><arguments>
          <argument>--release</argument><argument>17</argument><argument>-encoding</argument><argument>UTF-8</argument>
          <argument>-d</argument><argument>${project.build.directory}/node-processor</argument>
          <argument>${project.basedir}/src/processor/java/com/vin/easyknack/processor/NodeProcessor.java</argument>
        </arguments></configuration>
      </execution><execution><id>generate-native-contracts</id><phase>process-classes</phase><goals><goal>java</goal></goals>
        <configuration><mainClass>com.vin.easyknack.nodes.NativeContractGenerator</mainClass><arguments>
          <argument>${project.build.directory}/native/generated/ParameterContracts.hpp</argument>
          <argument>${project.build.outputDirectory}/easyknack/plugin-sdk.zip</argument>
        </arguments></configuration>
      </execution><execution><id>package-build-identity</id><phase>prepare-package</phase><goals><goal>exec</goal></goals>
        <configuration><executable>${java.home}/bin/java</executable><arguments>
          <argument>${project.basedir}/scripts/BuildMetadata.java</argument>
          <argument>${project.basedir}</argument>
          <argument>${project.build.outputDirectory}/META-INF/easyknack/build.properties</argument>
          <argument>${project.version}</argument><argument>${project.artifactId}</argument>
        </arguments></configuration>
      </execution></executions>
    </plugin>
  </plugins></build>
  <profiles>
    <profile>
      <id>native-audio</id>
      <properties><easyknack.test.audio>true</easyknack.test.audio></properties>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <executions><execution>
          <id>build-audio-host</id><phase>process-classes</phase><goals><goal>exec</goal></goals>
          <configuration>
            <executable>powershell.exe</executable>
            <arguments>
              <argument>-NoProfile</argument><argument>-ExecutionPolicy</argument><argument>Bypass</argument>
              <argument>-File</argument><argument>${project.basedir}/scripts/build-audio-host.ps1</argument>
              <argument>-Cxx</argument><argument>${audio.cxx}</argument>
            </arguments>
          </configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>native-audio-linux</id>
      <properties><audio.cxx>c++</audio.cxx></properties>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <executions><execution>
          <id>build-audio-host-linux</id><phase>process-classes</phase><goals><goal>exec</goal></goals>
          <configuration>
            <executable>bash</executable>
            <arguments>
              <argument>${project.basedir}/scripts/build-audio-host.sh</argument>
              <argument>--cxx</argument><argument>${audio.cxx}</argument>
            </arguments>
          </configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
